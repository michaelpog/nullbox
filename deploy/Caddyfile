# SITE_ADDRESS decides HTTP or HTTPS:
#   a domain (team-01.fasthacks.cloud): HTTPS. Caddy gets and renews a free Let's Encrypt
#     certificate by itself and redirects http:// to https://. Needs ports 80 and 443 open.
#   ":80" (the default): plain HTTP.
{$SITE_ADDRESS::80} {
	encode gzip

	# API requests go to the API container.
	handle /api/* {
		reverse_proxy nullbox-api:3000
	}

	# Everything else is the web app; unknown paths get index.html so React Router handles them.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Health check for the deploy workflow, reachable only inside the container.
:8081 {
	handle /api/healthz {
		reverse_proxy nullbox-api:3000
	}
	respond 404
}
